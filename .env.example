# TrafficCheck Cybersecurity Environment Configuration Example
# کۆپی ئەم فایلە بکە بە ناوی .env و زانیارییەکانی داتابەیس تێیدا دابنێ (هەرگیز .env مەنێرە بۆ GitHub)

# Server network binding (default: 127.0.0.1 for local desktop security)
HOST=127.0.0.1
PORT=3000

# Optional: comma-separated extra allowed hosts/origins only if LAN access is intentionally enabled
# ALLOWED_HOSTS=localhost:3000,127.0.0.1:3000
# ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Strong random session secret (auto-generated securely per boot if omitted)
# SESSION_SECRET=replace_with_at_least_32_random_characters

# Primary SQL Server (Use least-privilege account instead of sa!)
DB190_HOST=62.201.232.190
DB190_PORT=1433
DB190_NAME=Car_Registraion
DB190_USER=trafficcheck_app
DB190_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DB190_ENCRYPT=false

# Secondary / HQ SQL Server
DB90_HOST=62.201.232.90
DB90_PORT=1433
DB90_NAME=Car_Registraion
DB90_USER=trafficcheck_app
DB90_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DB90_ENCRYPT=false
